# xbps package of fili-term (Aéroport), read by distro/build-repo.sh of Filigrane (the Makefile installs the files).
# Qt Quick comes with Quickshell already; qt6-wayland is the platform plugin. The session daemon only links libc.
DESC="Aéroport, the terminal of Filigrane (Qt Quick, Rust)"
DEPENDS="glibc>=2.39_1 libgcc>=0 qt6-declarative>=0 qt6-wayland>=0"
SHLIBS="libc.so.6 libgcc_s.so.1 libstdc++.so.6 libQt6Core.so.6 libQt6Gui.so.6 libQt6Qml.so.6 libQt6Quick.so.6"
PKG_LICENSE="GPL-3.0-or-later"
# Programs of the package (bootstrap.sh without packages copies each one) and other names of fili-term
BINS="fili-term fili-term-daemon"
ALIASES="aeroport"
